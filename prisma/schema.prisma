// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for Credentials provider
  role          String    @default("user") // "user" | "admin"
  is_approved   Boolean   @default(false)  // Approval logic replacement

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  projectAssessors ProjectAssessor[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Master Data - templates, competencies, etc. required before project creation
model MasterData {
  id        String   @id @default(cuid())
  type      String   // "template" | "competency" | "dictionary"
  name      String
  data      Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Project Management
model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  configuration Json     @default("{}")
  status        String   @default("draft") // "draft" | "active" | "completed"
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches       Batch[]
  assessors     ProjectAssessor[]
  events        DomainEvent[]
}

model Batch {
  id        String   @id @default(cuid())
  name      String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitations Invitation[]
}

model Invitation {
  id        String   @id @default(cuid())
  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  email     String
  name      String
  status    String   @default("pending") // "pending" | "sent" | "accepted" | "expired"
  sentAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectAssessor {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, userId])
}

model DomainEvent {
  id        String   @id @default(cuid())
  type      String   // "SubmitProject" | "AssesseeNotified" | "AssessorAssigned" | "KamusSubmitted"
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
}

// Kamus - Dictionary of competency and potential items
model Kamus {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  type                String   // "potensi" | "kompetensi"
  description         String   @db.Text
  behavioralIndicators String  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?

  standarJabatanItems StandarJabatanKompetensi[]
  scenarioItems       ScenarioKompetensi[]
}

// Standar Jabatan - placeholder for future epic; needed now so Kamus deletion can be blocked when in use
model StandarJabatan {
  id          String   @id @default(cuid())
  name        String
  level       String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       StandarJabatanKompetensi[]
}

model StandarJabatanKompetensi {
  id               String         @id @default(cuid())
  standarJabatanId String
  kamusId          String
  expectedLevel    Int            @default(1)
  createdAt        DateTime       @default(now())

  standarJabatan   StandarJabatan @relation(fields: [standarJabatanId], references: [id], onDelete: Cascade)
  kamus            Kamus          @relation(fields: [kamusId], references: [id])

  @@unique([standarJabatanId, kamusId])
}

// Scenario - placeholder for future epic
model Scenario {
  id           String   @id @default(cuid())
  name         String
  type         String?
  description  String?  @db.Text
  duration     Int?
  instructions String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        ScenarioKompetensi[]
}

model ScenarioKompetensi {
  id         String   @id @default(cuid())
  scenarioId String
  kamusId    String
  createdAt  DateTime @default(now())

  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  kamus      Kamus    @relation(fields: [kamusId], references: [id])

  @@unique([scenarioId, kamusId])
}
